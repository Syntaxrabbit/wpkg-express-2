msgid "This field must contain a valid group name."
msgstr "Dieses Feld muss einen gültigen Gruppennamen enthalten."

msgid "Incorrect value for checkbox"
msgstr "Ungültiger Wert für das Kontrollkästchen."

msgid "This field must contain a valid e-mail"
msgstr "Dieses Feld muss eine gültige E-Mail-Adresse enthalten."

msgid "This field must contain a valid subject of e-mail"
msgstr "Dieses Feld muss einen gültigen E-Mail-Betreff enthalten."

msgid "Invalid SMTP Server"
msgstr "Ungültiger SMTP-Server."

msgid "Invalid port number"
msgstr "Ungültige Portnummer."

msgid "Invalid SMTP Username"
msgstr "Ungültiger SMTP-Benutzername."

msgid "Invalid SMTP password"
msgstr "Ungültiges SMTP-Passwort."

msgid "Passwords dont match"
msgstr "Die Passwörter stimmen nicht überein."

msgid "This field must contain a valid limit of autocomplete between %d and %d"
msgstr "Dieses Feld muss einen gültigen Autovervollständigungsgrenzwert zwischen %d und %d enthalten."

msgid "This field must contain a valid company name"
msgstr "Dieses Feld muss einen gültigen Firmennamen enthalten."

msgid "This field must contain a valid language name"
msgstr "Dieses Feld muss einen gültigen Sprachnamen enthalten."
